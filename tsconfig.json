{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": false,
    "target": "es2017",
    "declaration": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    // It's shit.
    // "baseUrl": "src",
    // "paths": {
    //   "@core/*": ["core/*"],
    //   "@lib/*": ["lib/*"],
    //   "@plugins/*": ["plugins/*"],
    //   "@utils/*": ["utils/*"]
    // },
    "lib": [
      "es2018",
      "es2017",
      "es2015",
      "es6",
      "DOM"
    ]
  },
  "include": [
    "./src/**/*"
  ]
}
