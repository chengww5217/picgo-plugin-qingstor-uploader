{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": false,
    "target": "es2017",
    "declaration": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    "lib": [
      "es2018",
      "DOM"
    ]
  },
  "include": [
    "./src/**/*"
  ]
}
