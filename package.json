{
  "name": "picgo-plugin-qingstor-uploader",
  "version": "1.2.7",
  "description": "青云 QingStor（青云对象存储）图床插件 / PicGo uploader for QingCloud object storage",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/chengww5217/picgo-plugin-qingstor-uploader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengww5217/picgo-plugin-qingstor-uploader.git"
  },
  "bugs": {
    "url": "https://github.com/chengww5217/picgo-plugin-qingstor-uploader/issues"
  },
  "scripts": {
    "test": "npm run build && node --test",
    "build": "tsc -p .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.js\"",
    "prepublishOnly": "npm run format:check && npm test"
  },
  "keywords": [
    "picgo",
    "picgo-gui-plugin",
    "picgo-plugin",
    "青云对象存储图床",
    "qingstor-uploader"
  ],
  "author": "chengww",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "peerDependencies": {
    "picgo": ">=1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "picgo": "^3.1.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
